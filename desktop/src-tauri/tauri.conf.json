{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typing Cat",
  "version": "1.1.2",
  "identifier": "com.typingcat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1424",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "打字猫",
        "width": 351,
        "height": 403,
        "minWidth": 270,
        "minHeight": 310,
        "decorations": false,
        "skipTaskbar": false,
        "transparent": true,
        "resizable": true,
        "center": true,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "设置",
        "url": "index.html?window=settings",
        "width": 276,
        "height": 540,
        "decorations": false,
        "skipTaskbar": true,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "wardrobe",
        "title": "装扮",
        "url": "index.html?window=wardrobe",
        "width": 318,
        "height": 496,
        "decorations": false,
        "skipTaskbar": true,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost blob: ws://localhost:1424 ws://localhost:1425; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
